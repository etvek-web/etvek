{
  "name": "etvek",
  "version": "1.0.0",
  "private": true,
  "description": "ETVEK — Estudio Técnico Vocal de Eliana Kestler. Sitio público + CMS administrativo.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
