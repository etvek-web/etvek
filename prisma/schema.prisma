// ETVEK — Estudio Técnico Vocal de Eliana Kestler
// Prisma schema. Base de datos: Prisma Postgres (Vercel Marketplace).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Currency {
  ARS
  USD
}

enum AdmissionStatus {
  NUEVA
  PENDIENTE
  CONTACTADA
  EVALUACION_AGENDADA
  PENDIENTE_DE_PAGO
  COMPROBANTE_RECIBIDO
  CONFIRMADA
  CERRADA
  RECHAZADA
}

enum ExperienceLevel {
  PROFESIONAL
  SEMI_PROFESIONAL
  OTRO
}

enum PaymentStatus {
  PENDIENTE
  COMPROBANTE_RECIBIDO
  VERIFICADO
  RECHAZADO
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum SectionKind {
  HERO
  RICH_TEXT
  CREDENTIAL_STRIP
  MANIFESTO
  PILLARS
  PROGRAM_GRID
  COUNTRY_COVERAGE
  TESTIMONIALS
  SUCCESS_CASES
  TIMELINE
  BIO
  CTA
  FAQ
  CONTACT_FORM
  PAYMENT_INFO
  SCHEDULER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  admissionNotes AdmissionNote[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Media {
  id            String          @id @default(cuid())
  blobUrl       String
  blobPathname  String          @unique
  fileName      String
  mimeType      String
  width         Int?
  height        Int?
  size          Int
  originalSize  Int?
  hash          String?
  alt           String          @default("")
  description   String?
  visibility    MediaVisibility @default(PUBLIC)
  keepOriginal  Boolean         @default(false)
  originalUrl   String?
  folder        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  sectionsImage   PageSection[]   @relation("SectionImage")
  programs        Program[]
  timelineEvents  TimelineEvent[]
  testimonials    Testimonial[]
  successCases    SuccessCase[]
  seoOg           SeoMetadata[]
  settingsLogo    SiteSettings[]  @relation("SettingsLogo")
  settingsOg      SiteSettings[]  @relation("SettingsOg")

  @@index([visibility, deletedAt])
  @@index([hash])
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  status    ContentStatus @default(PUBLISHED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sections PageSection[]
  seo      SeoMetadata?
}

model PageSection {
  id        String        @id @default(cuid())
  pageId    String
  kind      SectionKind
  key       String
  eyebrow   String?
  title     String?
  subtitle  String?
  body      String?
  imageId   String?
  ctaLabel  String?
  ctaHref   String?
  ctaLabel2 String?
  ctaHref2  String?
  isVisible Boolean       @default(true)
  status    ContentStatus @default(PUBLISHED)
  sortOrder Int           @default(0)
  data      Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  image Media? @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)

  items PageSectionItem[]

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

/// Ítems repetibles de una sección (pilares, features, bullets).
model PageSectionItem {
  id        String   @id @default(cuid())
  sectionId String
  title     String
  body      String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
}

model Program {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  subtitle     String?
  summary      String?
  description  String?
  duration     String?
  sessions     String?
  icon         String?
  imageId      String?
  ctaLabel     String?
  ctaHref      String?
  priceArs     Int?
  priceUsd     Int?
  showPrice    Boolean       @default(false)
  featured     Boolean       @default(false)
  sortOrder    Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  image    Media?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  features ProgramFeature[]
  admissions AdmissionRequest[]
  payments   Payment[]

  @@index([status, sortOrder])
}

model ProgramFeature {
  id        String   @id @default(cuid())
  programId String
  label     String
  sortOrder Int      @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
}

model Credential {
  id          String        @id @default(cuid())
  label       String
  detail      String?
  icon        String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model TimelineEvent {
  id          String        @id @default(cuid())
  year        String?
  date        DateTime?
  title       String
  institution String?
  description String?
  country     String?
  city        String?
  imageId     String?
  link        String?
  category    String?
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
}

model Testimonial {
  id         String        @id @default(cuid())
  name       String
  role       String?
  project    String?
  country    String?
  quote      String
  videoUrl   String?
  instagram  String?
  imageId    String?
  sortOrder  Int           @default(0)
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
}

model SuccessCase {
  id          String        @id @default(cuid())
  person      String
  project     String?
  objective   String
  process     String?
  result      String?
  country     String?
  imageId     String?
  consent     Boolean       @default(false)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
}

model Country {
  id        String        @id @default(cuid())
  name      String        @unique
  code      String        @unique
  dialCode  String
  flag      String?
  timezone  String?
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  admissions AdmissionRequest[]

  @@index([status, sortOrder])
}

model AdmissionRequest {
  id           String          @id @default(cuid())
  fullName     String
  email        String
  dialCode     String
  whatsapp     String
  countryId    String?
  countryName  String?
  style        String?
  level        ExperienceLevel @default(OTRO)
  objective    String
  programId    String?
  source       String?
  status       AdmissionStatus @default(NUEVA)
  consent      Boolean         @default(false)
  ipHash       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  notes    AdmissionNote[]
  payments Payment[]

  @@index([status, createdAt])
  @@index([deletedAt])
}

/// Notas internas. Nunca se exponen públicamente ni se envían al alumno.
model AdmissionNote {
  id          String   @id @default(cuid())
  admissionId String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())

  admission AdmissionRequest @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([admissionId, createdAt])
}

model PaymentMethod {
  id          String        @id @default(cuid())
  name        String
  currency    Currency
  instructions String?
  holder      String?
  bank        String?
  cbu         String?
  alias       String?
  accountInfo String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments Payment[]

  @@index([status, sortOrder])
}

model Payment {
  id           String        @id @default(cuid())
  admissionId  String?
  programId    String?
  methodId     String?
  currency     Currency      @default(ARS)
  amount       Int?
  reference    String?
  status       PaymentStatus @default(PENDIENTE)
  receiptId    String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  admission AdmissionRequest? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  program   Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  method    PaymentMethod?    @relation(fields: [methodId], references: [id], onDelete: SetNull)
  receipt   PrivateFile?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Archivo privado (comprobantes). Nunca se expone su URL directamente.
model PrivateFile {
  id           String   @id @default(cuid())
  blobPathname String   @unique
  blobUrl      String
  fileName     String
  mimeType     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime @default(now())

  payment Payment?
}

model NavigationItem {
  id        String        @id @default(cuid())
  label     String
  href      String
  location  String        @default("HEADER")
  isExternal Boolean      @default(false)
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([location, sortOrder])
}

model SocialLink {
  id        String        @id @default(cuid())
  platform  String
  url       String
  handle    String?
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model SeoMetadata {
  id              String   @id @default(cuid())
  pageId          String?  @unique
  path            String   @unique
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?
  canonical       String?
  noindex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  page    Page?  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ogImage Media? @relation(fields: [ogImageId], references: [id], onDelete: SetNull)
}

/// Fila única (id = "singleton") con los ajustes globales del sitio.
model SiteSettings {
  id               String   @id @default("singleton")
  siteName         String   @default("ETVEK")
  tagline          String?
  contactEmail     String   @default("contacto@etvek.com")
  whatsappNumber   String?
  whatsappMessage  String   @default("Hola Eliana, me interesa solicitar una evaluación vocal en ETVEK.")
  /// Mensaje contextual por programa. `{programa}` se reemplaza por el nombre del plan.
  whatsappProgramMessage String @default("Hola Eliana, me interesa el programa de {programa}.")
  whatsappEnabled  Boolean  @default(true)
  schedulerUrl     String?
  schedulerProvider String  @default("calendly")
  schedulerEnabled Boolean  @default(false)
  logoId           String?
  defaultOgImageId String?
  analyticsEnabled Boolean  @default(false)
  colorBackground  String   @default("#111111")
  colorPrimary     String   @default("#005A9C")
  colorAccent      String   @default("#C5A059")
  colorSurface     String   @default("#FFFFFF")
  maintenanceMode  Boolean  @default(false)
  legalReviewNote  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  logo          Media? @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  defaultOgImage Media? @relation("SettingsOg", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Contador simple para rate limiting de formularios públicos.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
