# ─────────────────────────────────────────────────────────────
# ETVEK — variables de entorno
# Copiá este archivo a .env.local para desarrollo.
# En producción se cargan desde el dashboard de Vercel.
# NUNCA commitear el archivo .env con valores reales.
# ─────────────────────────────────────────────────────────────

# Prisma Postgres (Vercel Marketplace → Storage → Prisma Postgres).
# Vercel inyecta esta variable automáticamente al vincular la base al proyecto.
DATABASE_URL="postgresql://usuario:password@host:5432/etvek?sslmode=require"
# Conexión directa (sin pooler) para migraciones. Opcional si DATABASE_URL ya es directa.
DIRECT_DATABASE_URL=""

# Secreto de sesión del panel. Generalo con:  openssl rand -base64 48
# Mínimo 32 caracteres. Distinto en development, preview y production.
AUTH_SECRET=""

# Vercel Blob (Storage → Blob). Vercel la inyecta al vincular el store.
BLOB_READ_WRITE_TOKEN=""

# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://etvek.com"

# ── Opcionales ───────────────────────────────────────────────

# Aviso por email de nuevas admisiones. Si no se configuran,
# las solicitudes igualmente quedan registradas en /admin.
RESEND_API_KEY=""
NOTIFICATIONS_FROM="ETVEK <no-reply@etvek.com>"

# Sólo para el seed / creación de la administradora (no usar en producción
# como variables persistentes: se leen una vez y se pueden borrar después).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Eliana Kestler"
